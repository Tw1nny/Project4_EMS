# Скопируйте этот файл в .env и заполните своими значениями.

# --- Django ---
# Сгенерировать ключ:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=ems_db
DB_USER=postgres
DB_PASSWORD=you_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis (серверный кеш) ---
CACHE_ENABLED=True
REDIS_URL=redis://127.0.0.1:6379/2

# --- Почта ---
# Без этих строк письма печатаются в консоль runserver.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=you@yandex.ru
# EMAIL_HOST_PASSWORD=app_password_here
# DEFAULT_FROM_EMAIL=you@yandex.ru
